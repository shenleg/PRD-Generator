        "resolution": "ask_design",
        "reason": "未提供视觉稿及状态设计。",
        "impact": "影响筛选、阅读与明细定位体验。",
        "options": [
          "提供低保真布局与关键状态",
          "先提供交互说明",
          "其他或暂不确定"
        ],
        "recommendation": "建议口径明确后依据数据特点选择展示形式。",
        "status": "open",
        "related_ids": [
          "$function"
        ]
      }
    },
