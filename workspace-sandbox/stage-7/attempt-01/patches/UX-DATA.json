        "resolution": "ask_product",
        "reason": "刷新规则未定，结果时效影响统计解释。",
        "impact": "影响数据正确性预期与验收。",
        "options": [
          "按明确周期刷新并展示数据时间",
          "按查询时获取的数据计算",
          "其他或暂不确定"
        ],
        "recommendation": "建议先明确业务可接受的数据时效及展示要求，不预设刷新频率。",
        "status": "open",
        "related_ids": [
          "$function"
        ]
      }
    },
