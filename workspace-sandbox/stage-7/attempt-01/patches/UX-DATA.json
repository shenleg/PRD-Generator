        "resolution": "ask_product",
        "reason": "异常数据处理未定。",
        "impact": "影响统计口径及明细对账。",
        "options": [
          "排除并明确提示",
          "纳入并标记异常",
          "按异常类型分别处理",
          "其他或暂不确定"
        ],
        "recommendation": "建议按异常类型明确处理及展示，待产品确认。",
        "status": "open",
        "related_ids": [
          "$function"
        ]
      }
    },
